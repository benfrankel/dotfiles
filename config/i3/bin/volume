#!/usr/bin/env bash

set -eu
set -x


SINK="@DEFAULT_SINK@"
VOLUME="$(pactl get-sink-volume "${SINK}" | grep -Eom 1 '[[:digit:]]+%' | head -n 1 | tr -d '%')"
MIN_VOLUME=0
MAX_VOLUME=500

USAGE='Usage: volume [on | off | toggle | set {} | (up|down) [more | {}]]'

if [ $# -ge 1 ]; then
    case $1 in
        on)
            pactl set-sink-mute "${SINK}" off
            ;;
        off)
            pactl set-sink-mute "${SINK}" on
            ;;
        toggle)
            pactl set-sink-mute "${SINK}" toggle
            ;;
        set)
            if [ $# -ne 2 ]; then
                echo $USAGE
                exit 1
            fi

            VOLUME=$2
            VOLUME=$((VOLUME>MAX_VOLUME?MAX_VOLUME:VOLUME))
            VOLUME=$((VOLUME<MIN_VOLUME?MIN_VOLUME:VOLUME))

            pactl set-sink-mute "${SINK}" off
            pactl set-sink-volume "${SINK}" "${VOLUME}"%
            ;;
        up|down)
            DELTA_VOLUME=2
            if [ $# -ge 3 ]; then
                echo $USAGE
                exit 1
            elif [ $# -eq 2 ]; then
                if [ "$2" = "more" ]; then
                    DELTA_VOLUME=5
                else
                    DELTA_VOLUME=$2
                fi
            fi

            case $1 in
                up)
                    VOLUME=$((VOLUME + DELTA_VOLUME))
                    VOLUME=$((VOLUME>MAX_VOLUME?MAX_VOLUME:VOLUME))
                    ;;
                down)
                    VOLUME=$((VOLUME - DELTA_VOLUME))
                    VOLUME=$((VOLUME<MIN_VOLUME?MIN_VOLUME:VOLUME))
                    ;;
                *)
                    echo $USAGE
                    exit 1
            esac

            pactl set-sink-mute "${SINK}" off
            pactl set-sink-volume "${SINK}" "${VOLUME}"%
            ;;
        *)
            echo $USAGE
            exit 1
    esac

    pkill -SIGRTMIN+10 i3blocks
else
    if [ -n "$(pactl get-sink-mute "${SINK}" | grep 'yes')" ]; then
        echo $VOLUME \(off\)
    else
        echo $VOLUME
    fi
fi

exit 0

